{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "esModuleInterop": true,
    "lib": ["ES2020"],
    "target": "ES2020",
    "types": ["node"]
  },
  "include": ["electron/**/*.ts", "vite.config.ts"]
}